# Copy to .env.prod (scripts/bootstrap-vps.sh does this for you) and edit.
# .env.prod is never committed.

# Public hostname (its DNS A record must point at this server) and e-mail for
# Let's Encrypt expiry notices.
APP_DOMAIN=warehouse.example.com
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_STAGING=false

# Local port the container is published on. Must be unique per project on this
# server (bootstrap-vps.sh picks a free one automatically).
HTTP_PORT=8090
# 127.0.0.1 = only the host nginx can reach it (recommended).
# 0.0.0.0   = reachable on the LAN over plain http (no phone camera!).
HTTP_BIND=127.0.0.1

# 1 = trust X-Forwarded-* from the host nginx (needed for secure cookies / client IPs).
TRUST_PROXY=1

# Image tag. Must match the tag you built or loaded.
VERSION=latest
TZ=Asia/Tehran
